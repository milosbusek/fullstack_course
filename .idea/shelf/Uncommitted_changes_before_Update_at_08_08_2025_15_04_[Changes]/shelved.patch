<+>/* Obecné nastavení pro tělo stránky */\r\n/*body {\r\n    font-family: Arial, sans-serif;\r\n    margin: 20px;\r\n    background-color: #f9f9f9;\r\n    color: #333;\r\n    text-align: center;\r\n}\r\n*/\r\nthead,\r\ntfoot,th {\r\n    border: 2px solid #8A8A8A;   /* color border */\r\n    font-weight: bold;\r\n    color: #000000;\r\n    background-color: #ffffff;\r\n    padding: 8px 12px;\r\n    text-align: center;\r\n}\r\n\r\ntbody tr:nth-child(even) {\r\n    background-color: #80c4ec;   /* background color even */\r\n    color: #000000;\r\n}\r\ntbody tr:nth-child(odd) {\r\n    background-color: #fff5ce;  /* background color odd */\r\n    color: #000000;\r\n}\r\ntbody tr:hover {\r\n    background-color: #f4dbdb;\r\n}\r\n\r\n\r\n/* Styl pro tabulku */\r\ntable#data {\r\n    border-collapse: collapse;\r\n    width: 100%;\r\n    margin-bottom: 20px;\r\n    font-size: 1.2em;\r\n}\r\n\r\ntable#data caption {\r\n    font-weight: bold;\r\n    font-size: 1.2em;\r\n    margin: 10px 0;\r\n}\r\n\r\n\r\n/* Styl pro formulář */\r\nform#mujformular .row {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: 20px;\r\n}\r\n\r\nform#mujformular .column {\r\n    flex: 1 1 200px;\r\n    display: flex;\r\n    flex-direction: column;\r\n}\r\n\r\nform#mujformular label {\r\n    font-weight: bold;\r\n    margin-bottom: 5px;\r\n}\r\n\r\nform#mujformular input {\r\n    padding: 8px;\r\n    border: 1px solid #ccc;\r\n    border-radius: 4px;\r\n}\r\n\r\nform#mujformular button {\r\n    padding: 10px 15px;\r\n    background-color: #28a745;\r\n    border: none;\r\n    color: white;\r\n    border-radius: 4px;\r\n    cursor: pointer;\r\n    font-weight: bold;\r\n    margin-top: 22px;\r\n}\r\n\r\nform#mujformular button:hover {\r\n    background-color: #218838;\r\n}}
